# YSACC TMS - 환경 변수 설정
# ⚠️ 이 파일은 GitHub에 절대 올리지 마세요! (.gitignore에 포함됨)

# ── PostgreSQL DB 연결 ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ysacc_tms
DB_USER=postgres
DB_PASSWORD=your_password_here

# AntiGravity DB를 사용할 경우:
# DB_HOST=antigravity-db-xxxx.xxx.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=ysacc_pi_prod
# DB_USER=antigravity_user
# DB_PASSWORD=antigravity_password

# ── 서버 설정 ──
PORT=3000
NODE_ENV=development

# ── 회사 정보 ──
COMPANY_CODE=YSACC
COMPANY_NAME=(주)와이에스에이씨씨

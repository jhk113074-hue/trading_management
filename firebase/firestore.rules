rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 인증된 사용자만 접근 허용 ──────────────────────────────────────
    // 로그인하지 않은 외부인은 어떤 데이터도 읽거나 쓸 수 없습니다.

    // 사용자 본인 프로필: 읽기는 모든 인증 사용자, 수정은 본인만
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 태스크: 로그인한 사용자 전체 허용 (협업 목적)
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    // 태스크 댓글: 로그인한 사용자 전체 허용
    match /taskComments/{commentId} {
      allow read, write: if request.auth != null;
    }

    // 회사 데이터 (PI, 주문, 제품, 고객, 공급업체 등): 로그인한 사용자만
    match /companies/{companyId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // 나머지 모든 컬렉션: 로그인한 사용자만
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

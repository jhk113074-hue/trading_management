// Firebase Firestore 보안 규칙
// Firebase Console → Firestore Database → Rules 탭에 붙여넣기

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 회사 데이터: 인증된 사용자만 접근
    match /companies/{companyId} {

      // 고객 정보
      match /customers/{customerId} {
        allow read, write: if request.auth != null;
      }

      // 공급업체 정보
      match /suppliers/{supplierId} {
        allow read, write: if request.auth != null;
      }

      // PI (견적서)
      match /proforma_invoices/{piId} {
        allow read, write: if request.auth != null;

        // PI Revisions
        match /revisions/{revisionId} {
          allow read, write: if request.auth != null;

          // Line Items
          match /line_items/{lineItemId} {
            allow read, write: if request.auth != null;
          }
        }
      }

      // PO (발주서)
      match /purchase_orders/{poId} {
        allow read, write: if request.auth != null;
        match /line_items/{lineItemId} {
          allow read, write: if request.auth != null;
        }
      }

      // 협상 이력
      match /negotiations/{negId} {
        allow read, write: if request.auth != null;
      }

      // PI 번호 카운터 (자동생성용)
      match /meta/{metaId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
